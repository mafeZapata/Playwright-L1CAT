{
  "name": "playwright-ecommerce-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation framework for automationexercise.com",
  "scripts": {
    "test": "npx playwright test",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "report": "npx playwright show-report reports/html-report",
    "trace": "npx playwright show-trace",
    "update-snapshots": "npx playwright test --update-snapshots"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
